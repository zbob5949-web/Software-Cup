# ============================================================
# 灵小游 Live2D 数字人 - 环境配置
# 复制此文件为 .env 并填入你的配置
# ============================================================

# --- Azure Speech SDK (推荐 — TTS + 精确 viseme 口型同步) ---
# 免费额度: 每月 50 万字符
# 创建资源: https://portal.azure.com → 创建"语音服务"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_VOICE=zh-CN-XiaoxiaoNeural

# --- LLM 配置 (可选) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 模型文件目录 ---
# STATIC_DIR=./live2d数字人

# --- 备用 TTS 语音 (Azure 不可用时使用 edge-tts) ---
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_SPEED=+5%
