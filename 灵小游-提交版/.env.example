# ============================================================
# 灵小游 Live2D 数字人 - 环境配置
# 复制此文件为 .env 并填入你的配置
# ============================================================

# --- 通义 DashScope Embedding（向量知识库，必填） ---
# 免费开通：https://dashscope.aliyun.com/ → 开通"文本向量"
# 新用户免费额度：50万 token/天
DASHSCOPE_API_KEY=

# --- DeepSeek LLM（AI 对话，必填） ---
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_KEY=

# --- JWT 签名密钥 ---
# 请使用随机字符串，例如: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# --- 数据库密码 ---
DB_PASSWORD=

# --- Azure Speech SDK (TTS + 口型同步，可选) ---
# 免费额度: 每月 50 万字符
# 创建资源: https://portal.azure.com → 创建"语音服务"
# 如不填则使用 edge-tts（免费，无需API Key）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_VOICE=zh-CN-XiaoxiaoNeural
