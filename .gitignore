# ---------------------------------------------------------
# 1. Python 基础忽略项
# ---------------------------------------------------------
# 字节码文件
__pycache__/
*.py[cod]
*$py.class

# 编译扩展
*.so

# ---------------------------------------------------------
# 2. 虚拟环境 (非常重要，不要上传你的环境)
# ---------------------------------------------------------
# venv, virtualenv, conda
venv/
env/
ENV/
.venv/
env/
condaenv/
.conda/

# 如果你用 pipenv 或 poetry
Pipfile.lock
poetry.lock

# ---------------------------------------------------------
# 3. 数据与模型文件 (AI 项目特有)
# ---------------------------------------------------------
# 向量数据库文件 (如果你用 ChromaDB/Faiss 本地存储)
# 这些文件通常很大，且是生成的，不需要版本控制
.chroma/
faiss_index/
db_index/

# 缓存目录
.cache/
.huggingface/

# 大型模型文件 (如果用 git-lfs 除外，否则建议忽略)
*.bin
*.pt
*.pth
*.ckpt

# ---------------------------------------------------------
# 4. 环境与密钥 (安全相关)
# ---------------------------------------------------------
# 环境变量文件 (存放 API Key)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Jupyter Notebook (如果包含敏感信息)
.ipynb_checkpoints

# ---------------------------------------------------------
# 5. 日志与临时文件
# ---------------------------------------------------------
logs
*.log
.DS_Store
Thumbs.db
*.swp
*.swo